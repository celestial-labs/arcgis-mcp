# =============================================================================
# arcgis-mcp configuration
# =============================================================================
# Copy this file to `.env` and fill in ONE authentication block.
# The auth mode is auto-detected by precedence: API key > app login >
# username/password > anonymous. (.env is gitignored.)
#
# NOTE: the server itself does NOT auto-load .env. Either export these vars in
# your shell, or set them in the `env` block of your MCP client config (see the
# Claude Desktop example in the README).

# --- Portal (optional) -------------------------------------------------------
# Defaults to ArcGIS Online. For ArcGIS Enterprise use your portal base URL,
# e.g. https://gis.example.com/portal
# ARCGIS_PORTAL_URL=https://www.arcgis.com

# --- Auth block 1: API key ---------------------------------------------------
# ARCGIS_API_KEY=AAPK...

# --- Auth block 2: OAuth 2.0 app login (client credentials) ------------------
# ARCGIS_CLIENT_ID=your-client-id
# ARCGIS_CLIENT_SECRET=your-client-secret

# --- Auth block 3: username / password ---------------------------------------
# ARCGIS_USERNAME=your-username
# ARCGIS_PASSWORD=your-password

# --- Auth block 4: anonymous -------------------------------------------------
# Set nothing. Only public items are searchable.

# --- Logging (optional) ------------------------------------------------------
# LOG_LEVEL=info        # debug | info | error

# --- Transport (optional) ----------------------------------------------------
# stdio (default): the MCP client launches the process locally.
# http:            hosted/remote mode — exposes POST/GET/DELETE /mcp.
# MCP_TRANSPORT=stdio
#
# HTTP transport only:
# PORT=3000             # host platforms usually inject this; else MCP_HTTP_PORT
# MCP_HTTP_PORT=3000    # used if PORT is unset
# MCP_HTTP_HOST=0.0.0.0
#
# In HTTP mode each request may carry its own ArcGIS token (per-request auth):
#   Authorization: Bearer <arcgis-token>      (or)      X-ArcGIS-Token: <token>
# Requests without a token fall back to the env credentials above.
